# =============================================================================
# IFNOTUS — Environment Configuration
# Copy to .env and adjust values for your environment
# =============================================================================

# Application
APP_NAME=IFNOTUS
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DEV_AUTH_BYPASS=false
API_PREFIX=/api
API_V1_PREFIX=/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# Security — CHANGE IN PRODUCTION
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://ifnotus:ifnotus@localhost:5432/ifnotus

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TASK_QUEUE=ifnotus:tasks

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Plugins
PLUGINS_ENABLED=true
PLUGINS_DIR=plugins

# Integrations (optional)
NETDATA_URL=
NGINX_CONFIG_PATH=/etc/nginx
GITHUB_API_URL=https://api.github.com

# SMTP (optional — customer notifications + ops panel test)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@ifnotus.space
SMTP_USE_TLS=true

# HTTP rate limits (Redis fixed-window; fails open if Redis down)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=8

# SMS (optional — none | log | http | hubtel)
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=IFNOTUS

# Mobile Money checkout (Paystack optional later)
MOMO_NETWORK=MTN
MOMO_NUMBER=0257940791
MOMO_ACCOUNT_NAME=Emmanuel Kwofie

# Support (shown on invoices and /contact)
SUPPORT_HOURS=Monday–Saturday, 08:00–20:00 GMT
SUPPORT_WHATSAPP=+233541069241
SUPPORT_EMAIL=support@ifnotus.space
COMPANY_LEGAL_NAME=IFNOTUS
COMPANY_CITY=Accra, Ghana
OPERATOR_ALERT_PHONE=+233541069241
PLATFORM_BACKUP_DIR=/srv/backups/ifnotus/platform
# After each daily Postgres dump, copy off this disk (same-disk backups are not DR).
# Placeholders: {path} = dump file, {dir} = PLATFORM_BACKUP_DIR
# Example: rsync -az {dir}/ backup@OTHER_HOST:/var/backups/ifnotus/
PLATFORM_BACKUP_OFFSITE_CMD=
# PHASE 24 — environment archive DR (none | command | s3)
BACKUP_OFFSITE_PROVIDER=none
# command: {path} archive, {key} object key, {dir} parent
BACKUP_OFFSITE_CMD=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=ifnotus/
BACKUP_KEEP_LOCAL_AFTER_OFFSITE=true
HOST_DISK_WARN_PCT=80
HOST_DISK_CRIT_PCT=90

# This Contabo start node (sellable disk after 20% reserve ≈ 200 GB)
INFRA_HOSTNAME=ifnotus-1
INFRA_CPU_TOTAL=12
INFRA_RAM_TOTAL_GB=48
INFRA_STORAGE_TOTAL_GB=200
INFRA_CPU_RESERVED_PCT=20

# Operations
OPERATIONS_BACKUP_DIR=.ifnotus/backups
WORKER_SERVICE_NAME=
APPLICATIONS_DIR=applications
APPLICATIONS_RELOAD_INTERVAL_SECONDS=60

# Monitoring engine
MONITORING_CACHE_TTL_SECONDS=15
MONITORING_HISTORY_POINTS=60
MONITORING_LOG_PATHS=/var/log/syslog,/var/log/system.log
MONITORING_CPU_ALERT_THRESHOLD=85
MONITORING_MEMORY_ALERT_THRESHOLD=85
MONITORING_DISK_ALERT_THRESHOLD=90
MONITORING_EXPECTED_PORTS=8000,5173,5432,6379
MYSQL_URL=
SUPERVISOR_SOCKET=/var/run/supervisor.sock

# Hosting control panel
WEBMAIL_URL=
CERTBOT_BINARY=certbot
SERVER_PUBLIC_IP=
HOSTING_ALLOWED_PATHS=/var/www,/home
MAIL_CONFIG_DIR=.ifnotus/mail
TERMINAL_COMMAND_TIMEOUT=30
TERMINAL_MAX_OUTPUT_BYTES=65536

# Namecheap domain registrar (optional — domain check / buy / nameserver assign)
# Whitelist SERVER_PUBLIC_IP in Namecheap → Profile → Tools → API Access
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_API_URL=https://api.namecheap.com/xml.response
NAMECHEAP_CONTACT_FIRST_NAME=IFNOTUS
NAMECHEAP_CONTACT_LAST_NAME=Hostmaster
NAMECHEAP_CONTACT_EMAIL=hostmaster@ifnotus.space
NAMECHEAP_CONTACT_PHONE=+233.200000000
NAMECHEAP_CONTACT_COUNTRY=GH

# Authoritative DNS (customers point nameservers here — never the VPS IP)
DNS_NS1=ns1.ifnotus.space
DNS_NS2=ns2.ifnotus.space
# Student/project hostnames (control plane stays on ifnotus.space)
STUDENT_ZONE=serverlabsttu.space
LEGACY_STUDENT_ZONE=ifnotus.space
BIND_ZONES_DIR=/etc/bind/zones
BIND_NAMED_CONF_LOCAL=/etc/bind/named.conf.local
BIND_CUSTOMER_CONF=/etc/bind/named.conf.customer
SERVER_PUBLIC_IPV6=

# FTP (customers see ftp.ifnotus.space — never the VPS IP)
FTP_ENABLED=true
FTP_PORT=21
FTP_PUBLIC_HOST=ftp.ifnotus.space
FTP_PASV_ADDRESS=

# Shared customer access (not SERVER_PUBLIC_IP). SSH jailed, not root, from ₵300/mo.
CUSTOMER_SHARED_IP=
CUSTOMER_SSH_HOST=ssh.ifnotus.space
CUSTOMER_SSH_MIN_PRICE_GHS=300

# VPS discovery (read-only scanning)
DISCOVERY_SCAN_PATHS=/srv/apps,/var/www,/opt
DISCOVERY_MAX_DEPTH=4
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
LETSENCRYPT_LIVE_DIR=/etc/letsencrypt/live
