$TTL 1800
@   IN SOA ns1.ifnotus.space. hostmaster.ifnotus.space. (
        2026082101 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300 )      ; negative cache
    IN NS  ns1.ifnotus.space.
    IN NS  ns2.ifnotus.space.
    IN A   80.241.223.82
    IN AAAA 2a02:c207:2337:9516::1
    IN MX  10 mail.ifnotus.space.
    IN TXT "v=spf1 ip4:80.241.223.82 a:mail.ifnotus.space ~all"

; Student/project hostnames: surname.serverlabsttu.space
* IN A      80.241.223.82
* IN AAAA   2a02:c207:2337:9516::1

www IN A    80.241.223.82
mail IN A   80.241.223.82

_dmarc IN TXT "v=DMARC1; p=none; rua=mailto:postmaster@ifnotus.space"
